<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ring.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
            Ring type, shape and control styles (udd/design.md) on top of the WinUI defaults. They
            live here rather than in a merged dictionary so BasedOn can reach the WinUI styles.
            Fonts are bundled beside Ring.exe; ms-appx:/// resolves to the exe folder for unpackaged
            apps. Each family lists its file with the legacy and the typographic family name, since
            DirectWrite may match either, then falls back to a system face.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="RingSansFont">ms-appx:///Assets/Fonts/BDOGrotesk-Regular.ttf#BDO Grotesk, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="RingSansMediumFont">ms-appx:///Assets/Fonts/BDOGrotesk-Medium.ttf#BDO Grotesk Medium, ms-appx:///Assets/Fonts/BDOGrotesk-Medium.ttf#BDO Grotesk, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="RingSansBoldFont">ms-appx:///Assets/Fonts/BDOGrotesk-Bold.ttf#BDO Grotesk, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="RingSerifFont">ms-appx:///Assets/Fonts/HedvigLettersSerif-Regular.ttf#Hedvig Letters Serif 24pt 24pt, ms-appx:///Assets/Fonts/HedvigLettersSerif-Regular.ttf#Hedvig Letters Serif 24pt, ms-appx:///Assets/Fonts/HedvigLettersSerif-Regular.ttf#Hedvig Letters Serif, Georgia</FontFamily>
            <FontFamily x:Key="RingPixelFont">ms-appx:///Assets/Fonts/GeistPixel-Square.ttf#Geist Pixel Square, ms-appx:///Assets/Fonts/GeistPixel-Square.ttf#Geist Pixel, Consolas</FontFamily>

            <!-- WinUI controls take their text face from this key. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/BDOGrotesk-Regular.ttf#BDO Grotesk, Segoe UI Variable Text, Segoe UI</FontFamily>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="RingCardCornerRadius">12</CornerRadius>
            <Thickness x:Key="RingHairline">0.5</Thickness>

            <!-- Type -->
            <Style x:Key="RingBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingSansFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="Foreground" Value="{ThemeResource RingForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="RingSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RingBodyTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource RingTextSecondaryBrush}" />
            </Style>

            <Style x:Key="RingStrongTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingSansMediumFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource RingForegroundBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RingPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingSerifFont}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="31" />
                <Setter Property="Foreground" Value="{ThemeResource RingInkBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RingHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingSerifFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="LineHeight" Value="26" />
                <Setter Property="Foreground" Value="{ThemeResource RingInkBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RingDisplayNameStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingSerifFont}" />
                <Setter Property="FontSize" Value="44" />
                <Setter Property="LineHeight" Value="52" />
                <Setter Property="Foreground" Value="{ThemeResource RingInkBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="RingPixelLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingPixelFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="30" />
                <Setter Property="Foreground" Value="{ThemeResource RingTextMutedBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RingSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource RingPixelLabelStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="4,0,0,8" />
            </Style>

            <!-- Surfaces -->
            <Style x:Key="RingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource RingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderBrush}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="RingBannerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource RingBeigeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="RingBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource RingBeigeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RingSiliconBadgeStyle" TargetType="Border" BasedOn="{StaticResource RingBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource RingAccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingAccentBorderBrush}" />
            </Style>

            <Style x:Key="RingBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RingPixelFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource RingTextSecondaryBrush}" />
            </Style>

            <Style x:Key="RingSiliconBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RingBadgeTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource RingAccentTextBrush}" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="RingPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource RingSansMediumFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="16,7" />
            </Style>

            <Style x:Key="RingSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource RingSansMediumFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Background" Value="{ThemeResource RingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0.5" />
            </Style>

            <Style x:Key="RingTextButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource RingSansMediumFont}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <!-- Round call controls: a filled circle, an ink overlay for hover and press. -->
            <Style x:Key="RingCircleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Background" Value="{ThemeResource RingBeigeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource RingForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderStrongBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                                <Setter Target="PressFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0.5" />
                                <Ellipse x:Name="HoverFill" Fill="{ThemeResource RingOverlayBrush}" Opacity="0" />
                                <Ellipse x:Name="PressFill" Fill="{ThemeResource RingOverlayBrush}" Opacity="0" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RingDangerCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource RingCircleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource RingDangerBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="RingInkCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource RingCircleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource RingInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource RingBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="RingSuccessCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource RingCircleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource RingSuccessBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <!-- Reason chips on the decline panel. -->
            <Style x:Key="RingChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource RingSansFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Background" Value="{ThemeResource RingBeigeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RingBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0.5" />
            </Style>

            <!-- Rows inside card groups. -->
            <Style x:Key="RingListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="4,1" />
            </Style>

            <Style x:Key="RingTranscriptItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
