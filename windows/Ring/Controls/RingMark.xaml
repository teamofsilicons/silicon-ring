<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Controls.RingMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- The Ring mark (assets/icon/icon.svg) drawn in XAML on its 200 x 200 grid. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="200">
            <Border x:Name="Tile" Background="#181818" CornerRadius="44" Visibility="Collapsed" />
            <Canvas Width="200" Height="200">
                <Ellipse x:Name="Dot" Canvas.Left="88" Canvas.Top="88" Width="23" Height="23" />
                <Ellipse x:Name="InnerRing" Canvas.Left="66" Canvas.Top="66" Width="67" Height="67" StrokeThickness="3" />
                <Ellipse x:Name="MiddleRing" Canvas.Left="54" Canvas.Top="55" Width="91" Height="89" StrokeThickness="2" />
                <Ellipse x:Name="OuterRing" Canvas.Left="44" Canvas.Top="44" Width="111" Height="111" StrokeThickness="1" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
