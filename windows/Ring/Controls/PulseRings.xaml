<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Controls.PulseRings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    IsTabStop="False">
    <!-- Faint rings that expand from the avatar while a call rings or connects (design.md motif). -->
    <Grid x:Name="Root">
        <Ellipse x:Name="Ring1" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource RingTextMutedBrush}" StrokeThickness="1">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring2" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource RingTextMutedBrush}" StrokeThickness="1">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring3" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{ThemeResource RingTextMutedBrush}" StrokeThickness="1">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
