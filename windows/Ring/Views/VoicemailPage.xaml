<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ring.Views.VoicemailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ring.Controls"
    xmlns:vm="using:Ring.ViewModels"
    Background="Transparent"
    FontFamily="{StaticResource RingSansFont}">
    <Grid Padding="24,0,24,24">
        <Border x:Name="ListCard" Padding="4" Style="{StaticResource RingCardStyle}" Visibility="Collapsed">
            <ListView
                x:Name="VoicemailList"
                IsItemClickEnabled="True"
                ItemClick="OnVoicemailClick"
                ItemContainerStyle="{StaticResource RingListViewItemStyle}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoicemailItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource RingAccentBrush}"
                                Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                            <controls:Avatar Grid.Column="1" VerticalAlignment="Center" Account="{x:Bind From}" Size="36" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RingStrongTextStyle}" Text="{x:Bind Title}" />
                                    <Border Style="{StaticResource RingSiliconBadgeStyle}" Visibility="{x:Bind SiliconVisibility}">
                                        <TextBlock Style="{StaticResource RingSiliconBadgeTextStyle}" Text="SILICON" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Meta, Mode=OneWay}" />
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource RingSecondaryTextStyle}"
                                    Text="{x:Bind Preview, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="3"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Play"
                                Click="OnPlayClick"
                                IsEnabled="{x:Bind CanPlay}"
                                Style="{StaticResource RingCircleButtonStyle}"
                                Tag="{x:Bind}">
                                <FontIcon FontSize="14" Glyph="{x:Bind PlayGlyph, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <controls:RingMark
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Mark="{ThemeResource RingTextMutedBrush}"
                Opacity="0.45" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource RingHeadingStyle}" Text="No voicemail" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource RingSecondaryTextStyle}"
                Text="Messages people leave when you miss, decline or are busy show up here."
                TextAlignment="Center" />
        </StackPanel>

        <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="False" />
    </Grid>
</Page>
