<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Views.RecordingNoticeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource RingSansFont}"
    Visibility="Collapsed">
    <!-- The scrim takes clicks, so nothing underneath responds until the notice is answered. -->
    <Grid x:Name="Scrim" Background="{ThemeResource RingScrimBrush}" TabFocusNavigation="Cycle">
        <ScrollViewer
            MaxWidth="480"
            Padding="16"
            VerticalAlignment="Center"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Border
                Padding="20"
                Background="{ThemeResource RingSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource RingBorderStrongBrush}"
                BorderThickness="0.5"
                CornerRadius="16">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource RingDangerBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="11"
                            Style="{StaticResource RingPixelLabelStyle}"
                            Text="RECORDED · TRANSCRIBED" />
                    </StackPanel>

                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource RingPageTitleStyle}"
                        Text="Ring records calls"
                        TextTrimming="None"
                        TextWrapping="Wrap" />

                    <!-- For a call that connected before this device agreed. -->
                    <TextBlock
                        x:Name="ContextText"
                        FontSize="15"
                        LineHeight="22"
                        Style="{StaticResource RingStrongTextStyle}"
                        TextTrimming="None"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <TextBlock
                        FontSize="15"
                        LineHeight="22"
                        Style="{StaticResource RingBodyTextStyle}"
                        Text="Every call is recorded and transcribed, so the people on it can read it and play it back later. Everyone on a call sees the same transcript." />

                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="13"
                                Foreground="{ThemeResource RingAccentTextBrush}"
                                Glyph="&#xE8F2;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="15"
                                LineHeight="22"
                                Style="{StaticResource RingSecondaryTextStyle}"
                                Text="Deepgram transcribes what people say." />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="13"
                                Foreground="{ThemeResource RingAccentTextBrush}"
                                Glyph="&#xE767;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="15"
                                LineHeight="22"
                                Style="{StaticResource RingSecondaryTextStyle}"
                                Text="When a silicon is on the call, OpenAI produces its voice and hears the call." />
                        </Grid>
                    </StackPanel>

                    <TextBlock
                        FontSize="13"
                        LineHeight="19"
                        Foreground="{ThemeResource RingTextMutedBrush}"
                        Style="{StaticResource RingBodyTextStyle}"
                        Text="Some places require everyone's consent to record a call. Let the people you call know." />

                    <Button
                        Margin="-10,0,0,0"
                        Click="OnPrivacyClick"
                        Style="{StaticResource RingTextButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Privacy Policy" />
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="12"
                                Glyph="&#xE8A7;" />
                        </StackPanel>
                    </Button>

                    <!-- Not now is Esc, Agree and continue is Enter. -->
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            x:Name="NotNowButton"
                            Click="OnNotNowClick"
                            Content="Not now"
                            KeyboardAcceleratorPlacementMode="Hidden"
                            Style="{StaticResource RingTextButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            x:Name="AgreeButton"
                            Click="OnAgreeClick"
                            Content="Agree and continue"
                            KeyboardAcceleratorPlacementMode="Hidden"
                            Style="{StaticResource RingPrimaryButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
