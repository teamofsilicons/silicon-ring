<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ring.Views.RecentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ring.Controls"
    xmlns:vm="using:Ring.ViewModels"
    Background="Transparent"
    FontFamily="{StaticResource RingSansFont}">
    <Grid Padding="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ListCard" Padding="4" Style="{StaticResource RingCardStyle}" Visibility="Collapsed">
            <ListView
                x:Name="CallsList"
                IsItemClickEnabled="True"
                ItemClick="OnCallClick"
                ItemContainerStyle="{StaticResource RingListViewItemStyle}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentCallItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Avatar VerticalAlignment="Center" Account="{x:Bind Peer}" Size="36" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource RingStrongTextStyle}" Text="{x:Bind Title}" Visibility="{x:Bind NormalVisibility}" />
                                    <TextBlock
                                        Foreground="{ThemeResource RingDangerBrush}"
                                        Style="{StaticResource RingStrongTextStyle}"
                                        Text="{x:Bind Title}"
                                        Visibility="{x:Bind MissedVisibility}" />
                                    <Border Style="{StaticResource RingSiliconBadgeStyle}" Visibility="{x:Bind SiliconVisibility}">
                                        <TextBlock Style="{StaticResource RingSiliconBadgeTextStyle}" Text="SILICON" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource RingTextMutedBrush}"
                                        Glyph="{x:Bind DirectionGlyph}"
                                        Visibility="{x:Bind NormalVisibility}" />
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource RingDangerBrush}"
                                        Glyph="{x:Bind DirectionGlyph}"
                                        Visibility="{x:Bind MissedVisibility}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Style="{StaticResource RingPixelLabelStyle}"
                                        Text="{x:Bind Meta}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Call back"
                                Click="OnRedialClick"
                                Style="{StaticResource RingTextButtonStyle}"
                                Tag="{x:Bind CallTarget}"
                                ToolTipService.ToolTip="Call">
                                <FontIcon FontSize="16" Foreground="{ThemeResource RingAccentTextBrush}" Glyph="&#xE717;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state: the faint Ring mark -->
        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <controls:RingMark
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Mark="{ThemeResource RingTextMutedBrush}"
                Opacity="0.45" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource RingHeadingStyle}" Text="No calls yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource RingSecondaryTextStyle}"
                Text="Call a carbon or a silicon by their id."
                TextAlignment="Center" />
        </StackPanel>

        <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="False" />

        <Button
            x:Name="MoreButton"
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Click="OnMoreClick"
            Content="Show older calls"
            Style="{StaticResource RingSecondaryButtonStyle}"
            Visibility="Collapsed" />
    </Grid>
</Page>
