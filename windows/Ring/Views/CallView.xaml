<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Views.CallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ring.Controls"
    xmlns:vm="using:Ring.ViewModels"
    FontFamily="{StaticResource RingSansFont}">
    <Grid Background="{ThemeResource RingBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Calling, ringing, voicemail and the outcome: one person, large. -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind Call.HeroVisibility, Mode=OneWay}">
            <Grid Width="240" Height="240" HorizontalAlignment="Center">
                <controls:PulseRings
                    Width="120"
                    Height="120"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind Call.RingsActive, Mode=OneWay}" />
                <controls:Avatar
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Account="{x:Bind Call.Primary.Account, Mode=OneWay}"
                    Size="120" />
            </Grid>
            <TextBlock MaxWidth="640" Style="{StaticResource RingDisplayNameStyle}" Text="{x:Bind Call.Title, Mode=OneWay}" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Call.Primary.Handle, Mode=OneWay}" />
                <Border Style="{StaticResource RingSiliconBadgeStyle}" Visibility="{x:Bind Call.Primary.SiliconBadgeVisibility, Mode=OneWay}">
                    <TextBlock Style="{StaticResource RingSiliconBadgeTextStyle}" Text="SILICON" />
                </Border>
            </StackPanel>
            <TextBlock
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource RingInkBrush}"
                Style="{StaticResource RingPixelLabelStyle}"
                Text="{x:Bind Call.Status, Mode=OneWay}" />
            <TextBlock
                MaxWidth="560"
                HorizontalAlignment="Center"
                Style="{StaticResource RingPixelLabelStyle}"
                Text="{x:Bind Call.Detail, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind Call.DetailVisibility, Mode=OneWay}" />
        </StackPanel>

        <!-- In call: timer, participants, live transcript. -->
        <Grid Padding="32,28,32,0" Visibility="{x:Bind Call.ConversationVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="13" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Call.Status, Mode=OneWay}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource RingInkBrush}"
                        Style="{StaticResource RingPixelLabelStyle}"
                        Text="{x:Bind Call.Timer, Mode=OneWay}" />
                </StackPanel>
                <ItemsControl HorizontalAlignment="Center" ItemsSource="{x:Bind Call.Peers, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="40" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CallPeer">
                            <StackPanel MaxWidth="220" Opacity="{x:Bind PeerOpacity, Mode=OneWay}" Spacing="8">
                                <controls:Avatar
                                    HorizontalAlignment="Center"
                                    Account="{x:Bind Account, Mode=OneWay}"
                                    IsSpeaking="{x:Bind IsSpeaking, Mode=OneWay}"
                                    Size="88" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="26"
                                    LineHeight="31"
                                    Style="{StaticResource RingHeadingStyle}"
                                    Text="{x:Bind Name, Mode=OneWay}" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <Border Style="{StaticResource RingSiliconBadgeStyle}" Visibility="{x:Bind SiliconBadgeVisibility, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource RingSiliconBadgeTextStyle}" Text="SILICON" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="1" MaxWidth="760" Margin="0,24,0,8">
                <ListView
                    x:Name="TranscriptList"
                    VerticalAlignment="Bottom"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource RingTranscriptItemStyle}"
                    ItemsSource="{x:Bind Call.Transcript, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TranscriptLine">
                            <StackPanel Opacity="{x:Bind Opacity, Mode=OneWay}" Spacing="3">
                                <TextBlock FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Speaker}" Visibility="{x:Bind SpeakerVisibility}" />
                                <TextBlock
                                    FontSize="17"
                                    LineHeight="25"
                                    Opacity="{x:Bind TextOpacity, Mode=OneWay}"
                                    Style="{StaticResource RingBodyTextStyle}"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    Visibility="{x:Bind TextVisibility}" />
                                <TextBlock FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Text, Mode=OneWay}" Visibility="{x:Bind SystemVisibility}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Lines fade as they move up behind this gradient. -->
                <Rectangle Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="{ThemeResource RingBackgroundColor}" />
                            <GradientStop Offset="1" Color="{ThemeResource RingBackgroundTransparentColor}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- Problems during the call ("Call audio was lost"), over the top of the screen. -->
        <InfoBar
            x:Name="NoticeBar"
            MaxWidth="640"
            Margin="24,16,24,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False" />

        <!-- Handoff note: "Moved to iPhone". -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Style="{StaticResource RingBannerStyle}"
            Visibility="{x:Bind Call.BannerVisibility, Mode=OneWay}">
            <TextBlock Style="{StaticResource RingBodyTextStyle}" Text="{x:Bind Call.Banner, Mode=OneWay}" />
        </Border>

        <!-- Controls -->
        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,32"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="28"
            Visibility="{x:Bind Call.ControlsVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid>
                    <Button AutomationProperties.Name="Mute" Click="OnMuteClick" Style="{StaticResource RingCircleButtonStyle}" Visibility="{x:Bind Call.UnmutedVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE720;" />
                    </Button>
                    <Button AutomationProperties.Name="Unmute" Click="OnMuteClick" Style="{StaticResource RingInkCircleButtonStyle}" Visibility="{x:Bind Call.MutedVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xEC54;" />
                    </Button>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="{x:Bind Call.MuteLabel, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button x:Name="DevicesButton" AutomationProperties.Name="Audio devices" Style="{StaticResource RingCircleButtonStyle}">
                    <FontIcon Glyph="&#xE7F6;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="DevicesFlyout" Opening="OnDevicesFlyoutOpening" Placement="Top" />
                    </Button.Flyout>
                </Button>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="AUDIO" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button AutomationProperties.Name="Add person" Click="OnAddPersonClick" Style="{StaticResource RingCircleButtonStyle}">
                    <FontIcon Glyph="&#xE8FA;" />
                </Button>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="ADD" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind Call.DoneVisibility, Mode=OneWay}">
                <Button
                    Height="56"
                    MinWidth="96"
                    Click="OnHangUpClick"
                    Content="Done"
                    CornerRadius="28"
                    Style="{StaticResource RingPrimaryButtonStyle}" />
                <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="SEND" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button
                    Width="64"
                    Height="64"
                    AutomationProperties.Name="Hang up"
                    Click="OnHangUpClick"
                    FontSize="22"
                    Style="{StaticResource RingDangerCircleButtonStyle}">
                    <FontIcon Glyph="&#xE778;" />
                </Button>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource RingPixelLabelStyle}" Text="END" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
