<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource RingSansFont}">
    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="216"
        PaneDisplayMode="Left"
        SelectionChanged="OnNavSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="RecentsItem" Content="Recents" Tag="recents">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="VoicemailItem" Content="Voicemail" Tag="voicemail">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="VoicemailBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Background="{ThemeResource RingBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: back, serif page title, New call on the right. -->
            <Grid Margin="24,18,24,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back"
                    Click="OnBackClick"
                    Style="{StaticResource RingTextButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    x:Name="PageTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource RingPageTitleStyle}"
                    Text="Recents" />
                <Button
                    x:Name="NewCallButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnNewCallClick"
                    Style="{StaticResource RingPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE717;" />
                        <TextBlock Text="New call" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                x:Name="NoticeBar"
                Grid.Row="1"
                Margin="24,0,24,12"
                IsOpen="False" />

            <Border
                x:Name="ElsewhereBanner"
                Grid.Row="2"
                Margin="24,0,24,12"
                Style="{StaticResource RingBannerStyle}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource RingInkBrush}" Glyph="&#xE717;" />
                    <TextBlock
                        x:Name="ElsewhereText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource RingBodyTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        Grid.Column="2"
                        Click="OnSwitchHereClick"
                        Content="Switch to this PC"
                        Style="{StaticResource RingPrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="3" Navigated="OnNavigated" />
        </Grid>
    </NavigationView>
</UserControl>
