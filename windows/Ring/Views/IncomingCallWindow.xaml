<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ring.Views.IncomingCallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ring.Controls"
    Title="Incoming call">
    <!-- A "moment" screen in the Ring mark's colours: ink in both themes. -->
    <UserControl FontFamily="{StaticResource RingSansFont}" RequestedTheme="Dark">
        <Grid Padding="24,20,24,24" Background="{ThemeResource RingBackgroundBrush}" BorderBrush="{ThemeResource RingBorderStrongBrush}" BorderThickness="0.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:RingMark Width="14" Height="14" ShowTile="True" />
                <TextBlock
                    VerticalAlignment="Center"
                    CharacterSpacing="80"
                    FontFamily="{StaticResource RingPixelFont}"
                    FontSize="11"
                    Foreground="{ThemeResource RingTextMutedBrush}"
                    Text="RING" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                <Grid Width="200" Height="200" HorizontalAlignment="Center">
                    <controls:PulseRings
                        x:Name="Rings"
                        Width="88"
                        Height="88"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="True" />
                    <controls:Avatar
                        x:Name="CallerAvatar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Size="88" />
                </Grid>
                <TextBlock
                    x:Name="CallerName"
                    FontSize="32"
                    LineHeight="38"
                    Style="{StaticResource RingDisplayNameStyle}" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="CallerHandle" VerticalAlignment="Center" Style="{StaticResource RingPixelLabelStyle}" />
                    <Border x:Name="SiliconBadge" Style="{StaticResource RingSiliconBadgeStyle}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource RingSiliconBadgeTextStyle}" Text="SILICON" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource RingInkBrush}"
                    Style="{StaticResource RingPixelLabelStyle}"
                    Text="IS CALLING" />
                <TextBlock
                    x:Name="AlsoText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource RingPixelLabelStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Decline once: reasons. Decline again: no reason. -->
            <StackPanel x:Name="ReasonsPanel" Grid.Row="2" Margin="0,0,0,16" Spacing="8" Visibility="Collapsed">
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="Reason0" HorizontalAlignment="Stretch" Click="OnReasonClick" Style="{StaticResource RingChipButtonStyle}" />
                    <Button x:Name="Reason1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnReasonClick" Style="{StaticResource RingChipButtonStyle}" />
                    <Button x:Name="Reason2" Grid.Row="1" HorizontalAlignment="Stretch" Click="OnReasonClick" Style="{StaticResource RingChipButtonStyle}" />
                    <Button x:Name="Reason3" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnReasonClick" Style="{StaticResource RingChipButtonStyle}" />
                </Grid>
                <TextBox
                    x:Name="ReasonBox"
                    KeyDown="OnReasonKeyDown"
                    MaxLength="200"
                    PlaceholderText="Or type a reason"
                    TextChanged="OnReasonTextChanged" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Left" Spacing="8">
                    <Button
                        x:Name="DeclineButton"
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Decline"
                        Click="OnDeclineClick"
                        FontSize="22"
                        Style="{StaticResource RingDangerCircleButtonStyle}">
                        <FontIcon Glyph="&#xE778;" />
                    </Button>
                    <TextBlock
                        x:Name="DeclineLabel"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Style="{StaticResource RingPixelLabelStyle}"
                        Text="DECLINE" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnSilenceClick"
                    Style="{StaticResource RingTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE7ED;" />
                        <TextBlock Text="Silence" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="8">
                    <Button
                        x:Name="AcceptButton"
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Accept"
                        Click="OnAcceptClick"
                        FontSize="22"
                        Style="{StaticResource RingSuccessCircleButtonStyle}">
                        <FontIcon Glyph="&#xE717;" />
                    </Button>
                    <TextBlock
                        x:Name="AcceptLabel"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Style="{StaticResource RingPixelLabelStyle}"
                        Text="ACCEPT" />
                </StackPanel>
            </Grid>
        </Grid>
    </UserControl>
</Window>
