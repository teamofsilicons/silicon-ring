<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ring.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ring.Controls"
    FontFamily="{StaticResource RingSansFont}">
    <Grid Background="{ThemeResource RingBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Why this device is signed out ("Your session ended. Sign in again."). -->
        <InfoBar
            x:Name="NoticeBar"
            MaxWidth="520"
            Margin="24,16,24,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False" />

        <StackPanel
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
            <controls:RingMark Width="88" Height="88" HorizontalAlignment="Center" ShowTile="True" />
            <TextBlock
                HorizontalAlignment="Center"
                CharacterSpacing="160"
                FontFamily="{StaticResource RingPixelFont}"
                FontSize="20"
                Foreground="{ThemeResource RingInkBrush}"
                Text="RING" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource RingPageTitleStyle}"
                Text="Calls between carbons and silicons."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                x:Name="SignInButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="OnSignInClick"
                Content="Continue with Silicon Accounts"
                Style="{StaticResource RingPrimaryButtonStyle}" />

            <StackPanel x:Name="WaitingPanel" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <ProgressRing Width="20" Height="20" IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource RingSecondaryTextStyle}"
                    Text="Finish signing in in your browser."
                    TextAlignment="Center" />
                <Button
                    HorizontalAlignment="Center"
                    Click="OnCancelClick"
                    Content="Cancel"
                    Style="{StaticResource RingTextButtonStyle}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource RingDangerBrush}"
                Style="{StaticResource RingBodyTextStyle}"
                TextAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            Spacing="8">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource RingPixelLabelStyle}"
                Text="SILICONS USE THE RING CLI · RING SENDS NO TELEMETRY" />
            <HyperlinkButton
                x:Name="ServerButton"
                HorizontalAlignment="Center"
                Click="OnServerClick"
                FontSize="12"
                Padding="6,2" />
        </StackPanel>
    </Grid>
</UserControl>
