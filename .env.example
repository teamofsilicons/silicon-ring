# Silicon Ring environment variables. Names only: copy to .env.local (gitignored), fill in, and
# load with `set -a; . ./.env.local; set +a`. Production values live in the Secrets Manager secret
# silicon-ring/production, built by deploy/secrets.py and rendered on the host by
# deploy/render-config.py. Never commit values. Ring sends no telemetry and has no setting for it.

# ── ring-server (control plane) ───────────────────────────────────────────────────────────────
# Logging filter, for example info,ring_server=debug. Logs never contain tokens or call text.
RUST_LOG=
# Listen address (default 127.0.0.1:8765).
RING_BIND=
# SQLite directory (default /var/lib/ring).
RING_DATA_DIR=
# This server's public origin, e.g. https://backend.ring.teamofsilicons.com (required).
RING_PUBLIC_URL=
# The web app's origin, e.g. https://ring.teamofsilicons.com (required; also the web sign-in callback origin).
RING_WEB_URL=
# Extra browser origins allowed by CORS, comma-separated exact origins.
RING_ALLOWED_ORIGINS=
# SECRET. 64 hex characters (openssl rand -hex 32); seals Accounts refresh tokens. Changing it signs everyone out.
RING_ENCRYPTION_KEY=
# Silicon Accounts (default https://accounts.teamofsilicons.com) and the app id (default ring).
RING_ACCOUNTS_URL=
RING_ACCOUNTS_APP_ID=
# SECRET. The ring app's confidential-client secret (sa_app_…).
RING_ACCOUNTS_APP_SECRET=
# SECRET. Signing secret of the Accounts webhook at /v1/accounts/webhook (whsec_…).
RING_ACCOUNTS_WEBHOOK_SECRET=
# Ting backend (default https://backend.ting.teamofsilicons.com).
RING_TING_URL=
# LiveKit API on loopback (default http://127.0.0.1:7880) and the URL clients connect to (required).
RING_LIVEKIT_URL=
RING_LIVEKIT_PUBLIC_URL=
# SECRET. The LiveKit key pair from livekit.yaml (`keys:`); the secret is at least 32 characters.
RING_LIVEKIT_API_KEY=
RING_LIVEKIT_API_SECRET=
# SECRET. Shared by ring-server and ring-media for /internal/media (at least 16 characters).
RING_MEDIA_SECRET=
# APNs token key (VoIP and alert pushes): key id, team id, bundle id, and the .p8 as a file or base64.
RING_APNS_KEY_ID=
RING_APNS_TEAM_ID=
RING_APNS_BUNDLE_ID=
RING_APNS_KEY_FILE=
# SECRET.
RING_APNS_KEY_BASE64=
# FCM HTTP v1 service account JSON, as a file or base64. SECRET.
RING_FCM_SERVICE_ACCOUNT_FILE=
RING_FCM_SERVICE_ACCOUNT_BASE64=
# Web Push VAPID pair (base64url: raw 32-byte private scalar, 65-byte public point) and subject URL.
# SECRET (private key).
RING_VAPID_PRIVATE_KEY=
RING_VAPID_PUBLIC_KEY=
RING_VAPID_SUBJECT=
# S3 for recordings and voicemail audio, and the key prefix (production/, dev/, …).
RING_S3_BUCKET=
RING_S3_PREFIX=
AWS_REGION=
# Optional: serve a web export from ring-server itself (production serves it from Caddy instead).
RING_WEB_DIR=

# ── ring-media (server-side LiveKit participants) ─────────────────────────────────────────────
# ring-server's internal WebSocket, e.g. ws://127.0.0.1:8765/internal/media (required).
RING_MEDIA_SERVER_URL=
# Working files for recordings and voicemail (default data/media).
RING_MEDIA_DATA_DIR=
# SECRET. Representatives (GPT-Live), greetings and silicon voicemail (Natural Voices).
OPENAI_API_KEY=
# SECRET. Carbon speech and voicemail transcription (nova-3).
DEEPGRAM_API_KEY=
# ring-media also reads RING_MEDIA_SECRET, RING_LIVEKIT_URL, RING_S3_BUCKET and AWS_REGION above.

# ── Clients ───────────────────────────────────────────────────────────────────────────────────
# ring CLI, Linux and Windows apps: API origin (default https://backend.ring.teamofsilicons.com).
RING_API_URL=
# ring CLI state lives in $SILICON_HOME/.ring (default ~/.ring).
SILICON_HOME=
# Web development server: the ring-server that /v1 is proxied to (default http://127.0.0.1:8765).
RING_DEV_API=
# Web build: the realtime WebSocket URL, when it is not wss://<page origin>/v1/ws.
NEXT_PUBLIC_RING_WS_URL=
# Always 1. The web scripts set it themselves; set it too if you run next directly.
NEXT_TELEMETRY_DISABLED=
