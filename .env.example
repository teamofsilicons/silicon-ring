# Development defaults. Copy intentionally; do not overwrite an existing private .env.
RING_ENV=development
RING_BIND=127.0.0.1:8765
RING_DATA_DIR=data
RING_WEB_DIR=web/dist
RING_OWNER_ORG=tos
RING_DEFAULT_ORG=tos
# Comma-separated browser origins accepted by the WebSocket upgrade.
RING_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://localhost:1420

# Real IAM/provider integration: server-side only. Never use VITE_ for credentials.
RING_IAM_URL=https://backend.iam.teamofsilicons.com
RING_IAM_LOGIN_URL=https://iam.teamofsilicons.com/login
RING_IAM_APP_ID=ring
RING_IAM_APP_SECRET=
RING_IAM_WEBHOOK_SECRET=
RING_IAM_WEBHOOK_VERSION=1
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
RING_TING_URL=https://ting.teamofsilicons.com

# Production requires a protected, backed-up base64 32-byte encryption key.
RING_ENCRYPTION_KEY=
RING_S3_BUCKET=
AWS_REGION=us-west-1
RING_TELEMETRY_ENABLED=true
RING_TELEMETRY_BACKEND_KEY=
RING_TELEMETRY_CLI_KEY=
RING_TELEMETRY_WEB_ANALYTICS_KEY=
RING_TELEMETRY_WEB_EVENTS_KEY=
# RING_RELEASE_INDEX_FILE=/etc/ring/release-index.json

# Optional isolated development fixtures. Never enable fixture tokens in production.
# RING_DISABLE_PROVIDERS=1
# RING_TEST_APP_SECRET=local-only-ring-integration-secret
# RING_TEST_TOKENS_FILE=data/test-tokens.json
# RING_TEST_NATIVE_PUSH_ENABLED=false # opt-in APNs sandbox / FCM debug-device bindings only
# RING_IAM_TEST_APP_SECRET=
# RING_IAM_TEST_ENVIRONMENT_KEY=
# RING_TING_TEST_APP_SECRET=
# RING_TELEMETRY_TEST_CLI_KEY=

# CLI environment (normally supplied by the interpreter; use an absolute path):
# SILICON_HOME=/absolute/private/interpreter/home
# SILICON_ORG=tos
# SILICON_RING_SERVER_URL=ws://127.0.0.1:8765/ws
# SILICON_RING_TEST_APP_SECRET_FILE=/absolute/protected/test-secret
# SILICON_RING_RELEASE_PUBLIC_KEY=<deployment Ed25519 public key; bundled key is default>
