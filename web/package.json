{
  "name": "@silicon-ring/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "node scripts/assets.mjs && node scripts/next.mjs dev --hostname 127.0.0.1 --port 1420",
    "build": "node scripts/assets.mjs && node scripts/next.mjs build && node scripts/csp.mjs",
    "typecheck": "node scripts/assets.mjs && tsc --noEmit",
    "lint": "node scripts/assets.mjs && eslint --max-warnings=0 . && silicon-ui-check"
  },
  "dependencies": {
    "@teamofsilicons/silicon-ui": "0.2.0",
    "livekit-client": "2.22.4",
    "lucide-react": "^1.47.0",
    "marked": "18.1.1",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "typescript": "5.9.3"
  },
  "siliconUi": {
    "css": [
      "app/**/*.module.css",
      "components/**/*.module.css"
    ],
    "ignore": [],
    "baseline": "silicon-ui-baseline.json"
  }
}
