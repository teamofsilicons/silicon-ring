# LiveKit SFU for Silicon Ring (single node, no Redis).
# deploy/install-release.sh renders this into /etc/livekit/livekit.yaml (0640 root:livekit),
# filling {{LIVEKIT_API_KEY}} and {{LIVEKIT_API_SECRET}} from RING_LIVEKIT_API_KEY and
# RING_LIVEKIT_API_SECRET in the runtime secret. No Prometheus port and no debug handler.

port: 7880
bind_addresses:
  - 127.0.0.1

rtc:
  tcp_port: 7881
  udp_port: 7882-7892
  # STUN-discover the Elastic IP, and also advertise the private address so ring-media, on the
  # same host, connects without hairpinning through the internet gateway.
  use_external_ip: true
  advertise_internal_ip: true
  allow_tcp_fallback: true

turn:
  enabled: true
  udp_port: 3478
  # TURN over TLS on 443 would need Caddy's certificate and a layer-4 split; UDP covers most
  # restrictive networks, and ICE over TCP on 7881 covers the rest.
  tls_port: 0
  domain: backend.ring.teamofsilicons.com

keys:
  "{{LIVEKIT_API_KEY}}": "{{LIVEKIT_API_SECRET}}"

webhook:
  api_key: "{{LIVEKIT_API_KEY}}"
  urls:
    - http://127.0.0.1:8765/internal/livekit/webhook

room:
  # Rooms are created by ring-server; a silicon-to-silicon call can ring for 60 s before anyone
  # joins, so empty rooms must outlive the ringing window.
  auto_create: true
  empty_timeout: 180
  departure_timeout: 30
  enabled_codecs:
    - mime: audio/opus
    - mime: audio/red

audio:
  active_red_encoding: true

logging:
  level: info
  pion_level: error
