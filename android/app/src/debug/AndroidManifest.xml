<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: renders screens with sample data for design review on devices. -->
        <activity
            android:name=".debug.DesignCatalogActivity"
            android:exported="true"
            android:theme="@style/Theme.Ring" />
        <!-- Debug builds only: installs a development session over adb (see DevReceiver). -->
        <receiver
            android:name=".debug.DevReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.teamofsilicons.ring.DEV_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
