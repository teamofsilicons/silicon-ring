<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ring" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ring_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Incoming and in-call screens open on ink in both themes, like the Ring mark. -->
    <style name="Theme.Ring.Call">
        <item name="android:windowBackground">@color/ring_ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
